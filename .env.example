ANTHROPIC_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TEMPORAL_HOST=localhost:7233
POSTGRES_URL=postgresql://user:pass@localhost:5432/travel
REDIS_URL=redis://localhost:6379/0
CHROMA_PATH=./data/chroma

# Live data (optional). Put real values in env.local (git-ignored), never here.
AVIATIONSTACK_API=
VIATOR_SANDBOX_KEY=
VIATOR_PRODUCTION_KEY=
VIATOR_API_ENV=sandbox   # production is used only if APP_ENV=production too
# LLM_PROVIDER=anthropic   # switch the planner from the mock to Claude
SERPAPI_API_KEY=   # live Google Flights/Hotels prices (search only). SERPAPI_LIVE=0 turns it off
MAPBOX_API_KEY=   # real driving times (MAPBOX_LIVE=0 turns it off)
TRAVELDESK_API_KEY=   # B2B tours API; booking calls stay disabled unless TRAVELDESK_ALLOW_LIVE_BOOKING=true AND the key is a test key
TRAVELDESK_ALLOW_LIVE_BOOKING=false
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1   # local OpenAI-compatible proxy; LLM_PROVIDER=freellm to use it
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
